# Primary LLM provider (Groq OpenAI-compatible endpoint)
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional secondary fallback provider (Gemini OpenAI-compatible endpoint; all 3 required to enable)
LLM_FALLBACK_API_KEY=your_gemini_api_key_here
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# SQLite database file path
DB_PATH=zenvo.db
